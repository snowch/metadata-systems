{
  "name": "ms-notebook-buttons",
  "version": "1.0.0",
  "private": true,
  "description": "A row of large buttons at the top of every notebook in the chapter's JupyterLite site: Run all, Run below and Save, and arrows to the chapters either side.",
  "main": "index.js",
  "style": "style/index.css",
  "scripts": {
    "build": "node node_modules/@jupyter/builder/lib/build-labextension.js --core-package-file node_modules/@jupyterlab/core-meta/core.package.json ."
  },
  "devDependencies": {
    "@jupyter/builder": "1.2.3",
    "@jupyterlab/core-meta": "4.6.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlite/apputils": {
        "bundled": false,
        "singleton": true
      },
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    }
  },
  "dependencies": {
    "@jupyterlab/docmanager": "4.6.4",
    "@jupyterlite/apputils": "0.8.6",
    "@jupyterlite/services": "0.8.6"
  }
}
