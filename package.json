{
  "name": "metadata-systems",
  "author": "Christopher Snow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Metadata Systems: From Raw Files to a Working Metadata Platform. An interactive course on metadata and lineage, each chapter a notebook that runs in the browser.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "content"
  ],
  "scripts": {
    "dev": "npm run dev -w @ms/course",
    "build": "npm run build -w @ms/course",
    "preview": "npm run preview -w @ms/course",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:educational": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "./scripts/check.sh",
    "check:prose": "node scripts/prose.mjs && node --test scripts/prose.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
